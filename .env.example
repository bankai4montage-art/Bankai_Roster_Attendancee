# Bankai — Roster & Attendance (env example)

# باسورد الأدمن (إجباري في الإنتاج)
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# باسورد المشرفين العام (مشاهدة + تعديل الحضور اليومي فقط) — فاضي = مقفول
SUPERVISOR_PASSWORD=

# باسورد مشرف لكل فرع (اختياري) — بصيغة "الفرع=الباسورد" مفصولة بـ ; أو ,
# المشرف المسجّل بالباسورد ده يقدر يوافق/يرفض طلبات الحضور من DAS **لفرعه فقط**.
# من غيره المشرف العام يقدر يقرّر على طلبات الفرعين، والأدمن دايمًا يقدر.
# مثال: SUPERVISOR_BRANCH_PASSWORDS=QCD 1=SupPass1;QCD 2=SupPass2
SUPERVISOR_BRANCH_PASSWORDS=

# حسابات مشرفين بالاسم: "الاسم:الباسورد:الفرع" مفصولة بـ ; أو ,
# كل مشرف يشوف البيانات والحضور والطلبات والتقارير والغرامات لفرعه فقط،
# من غير جدول ولا إعدادات، وكل حاجة يعملها (حضور/موافقة/غرامة) بتتسجل باسمه.
# مثال (فصل قيمة الأس للتبييض):
# SUPERVISOR_ACCOUNTS=HAMED:pw1:QCD 2;Karim:pw2:QCD 2;Ramadan:pw3:QCD 2;Elsuid:pw4:QCD 1;Karim:pw5:QCD 1;Mohamed:pw6:QCD 1
SUPERVISOR_ACCOUNTS=

# سر توقيع الجلسات — اثبّته عشان الجلسات تفضل شغالة بعد إعادة النشر
SECRET_KEY=

# ============ ربط DAS (طلبات الحضور/الانصراف) ============
# نفس قيمة ROSTER_DAS_SECRET في سيرفر DAS. لو فاضية واجهات الربط مقفولة تمامًا.
DAS_SECRET=

DATABASE_URL=sqlite:///./bankai.db
PORT=8000
